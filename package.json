{
  "name": "dsh-theme-phantom-blade-zero",
  "version": "0.1.0",
  "description": "An ink-and-blood theme for the DeepSeek Harness Web GUI after 影之刃零 (Phantom Blade Zero): two palettes, canvas key art, drifting maple leaves, fine rain and a palette switch.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "phantom-blade-zero",
    "wuxia"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/reygreen1/dsh-theme-phantom-blade-zero#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reygreen1/dsh-theme-phantom-blade-zero.git"
  },
  "bugs": {
    "url": "https://github.com/reygreen1/dsh-theme-phantom-blade-zero/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
